# BoardLab product environment (sourced by boardlab-supervisor)
export XDG_RUNTIME_DIR=/run
export WAYLAND_DISPLAY=wayland-0
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
# Keep the product GPU path enabled; do not force QT_QUICK_BACKEND=software.
export BOARDLAB_DATA_ROOT=/var/lib/boardlab
export BOARDLAB_CACHE_DIR=/var/cache/boardlab
export BOARDLAB_LOG_DIR=/var/log/boardlab
export BOARDLAB_DEFAULT_WEB_TOKEN=topeet
export BOARDLAB_UPLOAD_ROOT=/var/lib/boardlab/uploads
