#!/bin/sh
### BEGIN INIT INFO
# Provides:          wpa_supplicant
# Required-Start:    dbus
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: wpa_supplicant D-Bus control interface for NetworkManager
### END INIT INFO

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
DAEMON=/usr/sbin/wpa_supplicant
PIDFILE=/run/wpa_supplicant-u.pid

start() {
	echo -n "Starting wpa_supplicant: "
	if pidof wpa_supplicant >/dev/null 2>&1; then
		echo "already running"
		return 0
	fi
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- -u || \
		"$DAEMON" -u -B
	echo "OK"
}

stop() {
	echo -n "Stopping wpa_supplicant: "
	start-stop-daemon -K -p "$PIDFILE" 2>/dev/null || true
	killall wpa_supplicant 2>/dev/null || true
	rm -f "$PIDFILE"
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
